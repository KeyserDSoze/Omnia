# Copy to docker/.env (or run docker/setup.sh / docker/setup.ps1, which also generates
# random secrets and the envelope key ring). Never commit docker/.env.

# Public URL users open in the browser (no trailing slash). Through Cloudflare Tunnel use
# https://tao.example.com; for host-only use http://localhost:59800.
TAO_PUBLIC_URL=http://localhost:59800
# Gateway port on the host (nginx: / web, /api API, /auth Keycloak).
TAO_HTTP_PORT=59800
# 127.0.0.1 = reachable only by a tunnel running on this host; 0.0.0.0 = whole LAN.
TAO_HTTP_BIND=127.0.0.1
# Host-only Keycloak admin console: http://localhost:59801/auth/admin
TAO_KEYCLOAK_ADMIN_PORT=59801
# tenant_id claim issued by Keycloak for every user of this installation.
TAO_TENANT_ID=default

POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
# Separate NON-superuser API role. MUST differ from POSTGRES_PASSWORD.
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
# Separate NO-TABLE-ACCESS role for the bounded expiry worker.
RETENTION_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
KEYCLOAK_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
KEYCLOAK_ADMIN=tao-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET

# Connectors (optional). Redirect URI to register: ${TAO_PUBLIC_URL}/connections/callback
# Microsoft Entra app registration (Web platform, client secret, delegated Graph permissions:
# User.Read Mail.Read Calendars.Read Tasks.ReadWrite Chat.Read offline_access).
# Tenant: organizations (any work/school account) | common (also personal) | <tenant id>
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=organizations
# Google Cloud OAuth client (type "Web application"); enable Calendar, Gmail and Tasks APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Social login on the Tao account with the same app registrations: google, microsoft or both.
# Add the redirect URI ${TAO_PUBLIC_URL}/auth/realms/tao/broker/<google|microsoft>/endpoint.
# Only users that already exist in Keycloak (same e-mail) can use it; the first time they
# confirm with their Tao password. Applied at every start by the keycloak-config service.
TAO_SOCIAL_LOGIN=

# OpenAI-compatible chat model for the opt-in "Piano del giorno". Empty = disabled.
# OpenAI: https://api.openai.com/v1 | Azure OpenAI: https://<resource>.openai.azure.com/openai/v1
# (LLM_AUTH_HEADER=api-key) | local Ollama (compose --profile ollama): http://ollama:11434/v1
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
LLM_AUTH_HEADER=bearer

# AI router for voice: browser (default) or off. Dictation uses the browser's speech recognition
# (it may send audio to the browser vendor, so the user gives a dedicated consent); Tao's voice
# uses only voices installed on the device. "server" is reserved for a future server engine.
TAO_SPEECH_TO_TEXT=browser
TAO_TEXT_TO_SPEECH=browser

# none (default) = no embeddings; ollama | azure require EMBEDDINGS_ENDPOINT.
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_ENDPOINT=
EMBEDDINGS_MODEL=nomic-embed-text
