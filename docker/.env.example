# Copy to docker/.env, replace ALL values with random local-only credentials.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
# none (default) = truthful pending embeddings. Ollama needs manual model download.
EMBEDDINGS_PROVIDER=none
# Separate NON-superuser API role. MUST differ from POSTGRES_PASSWORD.
APP_DB_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET

# Separate NO-TABLE-ACCESS role for the bounded expiry worker (not app/admin).
RETENTION_DB_PASSWORD=REPLACE_WITH_THIRD_RANDOM_SECRET

# Generate/mount an external 32-byte AES-GCM KEK file for API startup (see docs).
# No static key is shipped: docker/secrets/envelope.keyring.json is gitignored.

# Optional offline legacy-backfill maintenance identity. Use a separate random password.
# BACKFILL_DB_PASSWORD=
# OMNIA_BACKFILL_ROLE=omnia_backfill

# Optional offline global legacy COUNT-only account, distinct from backfill.
# BACKFILL_AUDIT_DB_PASSWORD=
# OMNIA_BACKFILL_AUDIT_ROLE=omnia_backfill_audit
