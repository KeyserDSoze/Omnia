FROM mcr.microsoft.com/dotnet/sdk:10.0.404-noble@sha256:8c6edfb26c85153f236d26efebd9ad349aec403583f343f201ee67838b23658d AS build
WORKDIR /workspace
COPY global.json ./
# Reject an unexpectedly different SDK in the actual image, not just the tag.
RUN test "$(dotnet --version)" = "10.0.404"
# NuGet locked graph and CI policy are repository-root MSBuild properties.
COPY Directory.Build.props ./
COPY src/backend/Omnia.Domain/ src/backend/Omnia.Domain/
COPY src/backend/Omnia.Application/ src/backend/Omnia.Application/
COPY src/backend/Omnia.Infrastructure/ src/backend/Omnia.Infrastructure/
COPY src/backend/Omnia.Api/ src/backend/Omnia.Api/
RUN dotnet restore src/backend/Omnia.Api/Omnia.Api.csproj --locked-mode
RUN dotnet publish src/backend/Omnia.Api/Omnia.Api.csproj --no-restore -c Release -o /output

FROM mcr.microsoft.com/dotnet/aspnet:10.0.15-noble@sha256:aac50ceef10391e78a899e3d2ccd00bbafa2dcb56ccf4586cbccf00edb84fc21
# Real runtime image must contain the intended framework patch versions.
RUN dotnet --list-runtimes | grep -F 'Microsoft.AspNetCore.App 10.0.15 ' \
 && dotnet --list-runtimes | grep -F 'Microsoft.NETCore.App 10.0.15 '
WORKDIR /app
COPY --from=build /output .
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "Omnia.Api.dll"]
