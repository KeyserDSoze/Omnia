{
  "realm": "omnia",
  "enabled": true,
  "displayName": "Omnia (local development only)",
  "clients": [
    {
      "clientId": "omnia-web",
      "name": "Omnia local SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:19006/*",
        "http://127.0.0.1:19006/*"
      ],
      "webOrigins": [
        "http://localhost:19006",
        "http://127.0.0.1:19006"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id local claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "local",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "omnia-api",
      "name": "Omnia API audience",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false
    }
  ],
  "clientScopes": [
    {
      "name": "omnia-api-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "audience omnia-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "omnia-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "omnia-api-audience"
  ]
}
