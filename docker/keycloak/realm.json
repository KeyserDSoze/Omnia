{
  "realm": "tao",
  "enabled": true,
  "displayName": "Tao (local development only)",
  "clients": [
    {
      "clientId": "tao-web",
      "name": "Tao local SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:19006/*",
        "http://127.0.0.1:19006/*"
      ],
      "webOrigins": [
        "http://localhost:19006",
        "http://127.0.0.1:19006"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id local claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "local",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "Subject (sub) for authenticated API",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "tao-api-audience"
      ]
    },
    {
      "clientId": "tao-api",
      "name": "Tao API audience",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false
    }
  ],
  "clientScopes": [
    {
      "name": "tao-api-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "audience tao-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "tao-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "tao-api-audience"
  ]
}
