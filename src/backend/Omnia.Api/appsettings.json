{
  "Auth": {
    "Issuer": "",
    "Audience": ""
  },
  "Database": {
    "ConnectionString": "",
    "MigrationConnectionString": "",
    "RetentionConnectionString": ""
  },
  "Embeddings": {
    "Provider": "none"
  },
  "Cors": {
    "Origins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimit": {
    "RequestsPerMinute": 120
  },
  "Crypto": {
