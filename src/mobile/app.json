{
  "expo": {
    "name": "Tao",
    "slug": "tao",
    "scheme": "tao",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tao.personalintelligence",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Tao registra audio soltanto dopo il tuo consenso esplicito."
      }
    },
    "android": {
      "package": "com.tao.personalintelligence",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Tao"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Consenti a Tao di registrare un memo audio su tua richiesta.",
          "enableBackgroundRecording": false
        }
      ]
    ]
  }
}
